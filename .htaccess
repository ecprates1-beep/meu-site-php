# ===============================================================
# Configuração Apache — HostGator (PHP 8.2+)
# Front Controller + proteção de pastas internas
# ===============================================================

# Desativa a listagem automática de diretórios
Options -Indexes

DirectoryIndex index.php

# Bloqueia arquivos sensíveis (.env, .gitignore, logs, backups, etc.)
<FilesMatch "(^\.|composer\.(json|lock)|\.(env|ini|log|sql|md|bak)$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Se o site ficar em uma subpasta, descomente e ajuste:
    # RewriteBase /meu-site-php/

    # Bloqueia acesso direto às pastas internas da aplicação
    RewriteRule ^(config|includes|pages)(/|$) - [F,L]
    RewriteRule ^\.git(/|$) - [F,L]

    # Não reescreve arquivos ou pastas que realmente existem (css, js, imagens)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Encaminha todo o restante para o Front Controller
    RewriteRule ^ index.php [L]
</IfModule>
